# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local database
*.db
*.db-journal
*.db.bak
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db.bak
prisma/prisma/dev.db
prisma/prisma/dev.db-journal
dev.db
dev.db-journal

# Zip backups
*.zip

# CSV samples
demo-schedule.csv
demo-schedule-v2.csv

# Ops - backups and logs (never commit)
ops/backups/*
!ops/backups/.gitkeep
ops/logs/*
!ops/logs/.gitkeep
